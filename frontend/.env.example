# Base URL of the ConsentShield FastAPI backend.
# Run the backend locally with: uvicorn app.main:app --reload --port 8000
VITE_API_BASE_URL=http://localhost:8000

# Sent as the X-Dev-User-Id header. Only used while the backend runs with
# AUTH_MODE=dev (the default, hackathon-only auth mode) -- see backend/.env.example.
# Any stable string works; it just scopes preferences/scans to "this user".
VITE_DEV_USER_ID=demo-user
