# --- App ---
API_VERSION=v1
ENVIRONMENT=hackathon        # hackathon | production

# --- CORS ---
# Comma-separated list of origins allowed to call this API from the browser.
# Add the origin the frontend is actually served from if it differs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
# In hackathon mode, requests may authenticate with header: X-Dev-User-Id: <any-uuid-like-string>
# In production mode, a Supabase JWT must be sent as: Authorization: Bearer <token>
AUTH_MODE=dev                # dev | supabase_jwt
SUPABASE_JWT_SECRET=

# --- Supabase (optional in hackathon mode; falls back to in-memory storage if unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Browser agent (Playwright + a free/open LLM) ---
BROWSER_MODE=live            # mock | live
AGENT_HEADLESS=false         # false = watch the browser click
# Uses your installed browser (no Chromium download): chrome | msedge | (empty = Playwright Chromium)
AGENT_BROWSER_CHANNEL=chrome
# AGENT_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Option 1 - NVIDIA NIM (Nemotron), free key from https://build.nvidia.com
AGENT_PROVIDER=openai
AGENT_BASE_URL=https://integrate.api.nvidia.com/v1
AGENT_API_KEY=
AGENT_MODEL=nvidia/nemotron-3-nano-30b-a3b
AGENT_KEEP_OPEN_SECONDS=60
# Option 2 - OpenRouter:  AGENT_BASE_URL=https://openrouter.ai/api/v1  (+ a ":free" model id)
# Option 3 - Ollama (local, no key):  AGENT_BASE_URL=http://localhost:11434/v1  AGENT_MODEL=llama3.2
# Leave AGENT_API_KEY empty (and not local) to skip the model and use keyword rules only.

# --- Model adapter ---
# When unset, a heuristic/rule-based classifier is used instead of a live model call.
MODEL_MODE=heuristic         # heuristic | live
MODEL_API_URL=
MODEL_API_KEY=

# --- Scan behavior ---
SCAN_POLL_AFTER_MS=1000
SCAN_MAX_PAGES=5
SCAN_TIMEOUT_SECONDS=45
EXECUTION_PLAN_TTL_SECONDS=300