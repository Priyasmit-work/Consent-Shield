# --- App ---
API_VERSION=v1
ENVIRONMENT=hackathon        # hackathon | production

# --- CORS ---
# Comma-separated list of origins allowed to call this API from the browser.
# Add the origin the frontend is actually served from if it differs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Auth ---
# In hackathon mode, requests may authenticate with header: X-Dev-User-Id: <any-uuid-like-string>
# In production mode, a Supabase JWT must be sent as: Authorization: Bearer <token>
AUTH_MODE=dev                # dev | supabase_jwt
SUPABASE_JWT_SECRET=

# --- Supabase (optional in hackathon mode; falls back to in-memory storage if unset) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Browser agent (webcmd) ---
# When unset, a deterministic mock explorer is used (safe for local/offline demo).
WEBCMD_MODE=mock             # mock | live
WEBCMD_API_KEY=

# --- Model adapter ---
# When unset, a heuristic/rule-based classifier is used instead of a live model call.
MODEL_MODE=heuristic         # heuristic | live
MODEL_API_URL=
MODEL_API_KEY=

# --- Scan behavior ---
SCAN_POLL_AFTER_MS=1000
SCAN_MAX_PAGES=5
SCAN_TIMEOUT_SECONDS=45
EXECUTION_PLAN_TTL_SECONDS=300
